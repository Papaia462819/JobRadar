{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // SQLite database file, created next to the executable's working directory.
    "Jobs": "Data Source=jobradar.db"
  },

  // Swappable provider. "Sqlite" works out of the box. To use Postgres:
  // add the Npgsql.EntityFrameworkCore.PostgreSQL package, set this to
  // "Postgres", point ConnectionStrings:Jobs at your server and regenerate
  // migrations (see README).
  "Database": {
    "Provider": "Sqlite"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "Scan": {
    // Hangfire cron (local time): every day at 08:00.
    "Cron": "0 8 * * *",
    // Listings posted more than this many days ago are skipped at ingest and
    // hidden from the API (0 = no cutoff). Jobs without a posted date are kept.
    "MaxJobAgeDays": 180
  },

  "Hangfire": {
    "DatabasePath": "hangfire.db"
  },

  // ---------------------------------------------------------------------
  // Adzuna (https://developer.adzuna.com) — register for free keys and put
  // them here (or in user-secrets / environment variables:
  //   Adzuna__AppId=... Adzuna__AppKey=...).
  // If left empty the Adzuna fetcher logs a warning and is skipped — the
  // rest of the pipeline (Arbeitnow etc.) keeps working.
  // ---------------------------------------------------------------------
  "Adzuna": {
    "AppId": "",
    "AppKey": "",
    "Country": "ro",
    // Broad dev/software/IT net — relevance scoring (not the fetch) is what
    // ranks .NET/C# jobs to the top.
    "Queries": [ "software developer", "software engineer", "web developer", "programator" ],
    "Where": "",
    "ResultsPerPage": 50,
    "MaxPagesPerQuery": 1
  },

  // Greenhouse public board API (no auth). These four boards are verified live
  // (2026-07-29) and hire remote across the EU — swap in the board tokens of
  // local/Timișoara companies you care about as you find them (the token is
  // the last part of a careers URL like boards.greenhouse.io/{token}).
  "Greenhouse": {
    "Boards": [ "gitlab", "grafanalabs", "canonical", "remotecom" ],
    "TechFilter": true
  },

  // eJobs.ro — scraping-based (fragile; see the note atop EjobsFetcher.cs).
  // Searches are path segments of ejobs.ro/locuri-de-munca/… so results come
  // pre-filtered to Timișoara and to remote, across the whole IT category.
  "Ejobs": {
    "Searches": [ "timisoara/it-software", "remote/it-software" ],
    "MaxPagesPerSearch": 2
  },

  // Arbeitnow (https://www.arbeitnow.com/api/job-board-api) — free, no auth.
  // TechFilter keeps only software/IT-looking jobs (the feed contains many
  // unrelated German listings); set it to false to store everything.
  "Arbeitnow": {
    "MaxPages": 3,
    "TechFilter": true
  },

  // Your relevance profile. Score = sum of matched keyword weights;
  // a title match counts TitleWeightMultiplier times more than a
  // description match. Timisoara/remote jobs get a small boost so the
  // "relevance" sort surfaces jobs you can actually take.
  "Profile": {
    "TitleWeightMultiplier": 3,
    "TimisoaraBoost": 4,
    "RemoteBoost": 2,
    "Keywords": [
      { "Term": ".net", "Weight": 5 },
      { "Term": "dotnet", "Weight": 5 },
      { "Term": "c#", "Weight": 5 },
      { "Term": "asp.net", "Weight": 5 },
      { "Term": "blazor", "Weight": 4 },
      { "Term": "mudblazor", "Weight": 4 },
      { "Term": "entity framework", "Weight": 3 },
      { "Term": "ef core", "Weight": 3 },
      { "Term": "full-stack", "Weight": 3 },
      { "Term": "full stack", "Weight": 3 },
      { "Term": "fullstack", "Weight": 3 },
      { "Term": "backend", "Weight": 3 },
      { "Term": "back-end", "Weight": 3 },
      { "Term": "software developer", "Weight": 2 },
      { "Term": "web developer", "Weight": 2 },
      { "Term": "software engineer", "Weight": 2 },
      { "Term": "junior", "Weight": 3 },
      { "Term": "mid-level", "Weight": 2 },
      { "Term": "medior", "Weight": 2 },
      { "Term": "sql", "Weight": 2 },
      { "Term": "postgresql", "Weight": 2 },
      { "Term": "linq", "Weight": 2 },
      { "Term": "yarp", "Weight": 2 },
      { "Term": "rest", "Weight": 1 },
      { "Term": "docker", "Weight": 1 },
      { "Term": "xunit", "Weight": 1 },
      { "Term": "azure", "Weight": 1 },
      { "Term": "react", "Weight": 1 }
    ]
  }
}
